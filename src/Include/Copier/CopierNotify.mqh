//+------------------------------------------------------------------+
//|                                                 CopierNotify.mqh |
//| Companion DLL interface for sub-millisecond hardware-level       |
//| socket event interrupts via Windows PostMessageW -> OnChartEvent |
//+------------------------------------------------------------------+
#property strict

#define CP_NOTIFY_VK_CODE 0x87 // VK_F24: high-order virtual key, never generated by physical keyboards

#import "copier_notify.dll"
intptr_t CopierNotifyStart(intptr_t socket,intptr_t hwnd_chart,int key_code);
void     CopierNotifyAck(intptr_t handle);
void     CopierNotifyStop(intptr_t handle);
#import

class CopierNotifier
  {
private:
   intptr_t          m_handle;

public:
                     CopierNotifier():m_handle(0){}
                    ~CopierNotifier(){ Stop(); }

   bool              Start(const intptr_t socketRef,const long chartHwnd,const int keyCode=CP_NOTIFY_VK_CODE)
     {
      Stop();
      if(socketRef==0 || chartHwnd==0) return false;
      m_handle=CopierNotifyStart(socketRef,(intptr_t)chartHwnd,keyCode);
      return (m_handle!=0);
     }

   void              Ack()
     {
      if(m_handle!=0) CopierNotifyAck(m_handle);
     }

   void              Stop()
     {
      if(m_handle!=0)
        {
         CopierNotifyStop(m_handle);
         m_handle=0;
        }
     }

   bool              Active() const { return (m_handle!=0); }
  };
