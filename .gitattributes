# Normalize all text to LF in the repo; check out with LF on every platform.
* text=auto eol=lf

# Binary file types: never apply CRLF conversion or text diffs.
*.a      binary
*.def    binary
*.dll    binary
*.exe    binary
*.lib    binary
*.exp    binary
*.ex4    binary
*.ex5    binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.bmp   binary
