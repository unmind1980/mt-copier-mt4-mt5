# Normalize all text to LF in the repo; check out with LF on every platform.
* text=auto eol=lf

# Binary file types: never apply CRLF conversion or text diffs.
*.a      binary
*.def    binary
*.dll    binary
*.exe    binary
*.lib    binary
*.exp    binary
*.ex4    binary
*.ex5    binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.bmp   binary

# Windows batch files MUST keep CRLF. cmd.exe tolerates LF for simple lines but
# `goto :label` and multi-line if(...) blocks are not guaranteed, and these
# scripts install/start/stop services - a mis-parse there is an operator-facing
# failure, not a cosmetic one.
*.bat    text eol=crlf
*.cmd    text eol=crlf
